# Copie para .env (na raiz) para configurar o docker compose. O .env é ignorado pelo git.

# Interface onde o frontend é publicado. Padrão: 127.0.0.1 (só este computador).
# Use 0.0.0.0 para acessar pelo celular ou outros aparelhos da rede (o acesso exige o token).
VITROLA_BIND=127.0.0.1

# Token de acesso. Se vazio, a API gera um em ./data/auth-token.txt (veja com: make token).
AUTH_TOKEN=

# true desliga a autenticação (facilita testes locais). Nunca use junto com VITROLA_BIND=0.0.0.0.
AUTH_DISABLED=true

# Nomes extras aceitos no header Host, separados por vírgula (IPs já são aceitos). Ex.: meupc.local
ALLOWED_HOSTS=
